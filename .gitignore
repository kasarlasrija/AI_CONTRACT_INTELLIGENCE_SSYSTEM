profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
#   According to pypa/pipenv#1291, pipenv should keep both Pipfile and Pipfile.lock in git,
#   but if you feel like choosing, uncomment the next line:
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock can be gitignored or not, limit choice by commenting next line
#poetry.lock

# pdm
.pdm.toml
.pdm-plugins/
__pdm-build/

# PEP 582; used by e.g. github.com/lincolnloop/layman and github.com/pdm-project/pdm
__puck__
__pypackages__/

